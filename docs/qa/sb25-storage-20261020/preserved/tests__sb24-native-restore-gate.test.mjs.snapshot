import test from "node:test";
import assert from "node:assert/strict";
import {readFileSync} from "node:fs";
const source=readFileSync(new URL("../src/eng-runtime.native.ts",import.meta.url),"utf8");
test("Development consumer Full v4 restore stays blocked until native acceptance",()=>{
 const entry=source.indexOf("export async function pickEngBackup()");
 assert.ok(entry>=0,"consumer backup picker exists");
 const block=source.slice(entry,source.indexOf("export type EngStore=",entry));
 const read=block.indexOf("await openEngStreamCompatible(");
 const gate=block.indexOf("if(opened.reminders!==null)throw Error(");
 const returnValue=block.indexOf("return opened;");
 assert.ok(read>=0&&gate>read&&returnValue>gate,"Full v4 gate must run after archive verification and before returning backup");
 assert.match(block,/Full v4 restore awaits emulator recovery acceptance/);
});
